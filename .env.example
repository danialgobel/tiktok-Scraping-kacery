# TikTok Affiliate Validator - Environment Configuration Template
# Salin file ini menjadi .env untuk penggunaan lokal.
# Untuk deployment Vercel, masukkan GEMINI_API_KEY di dashboard: Project Settings -> Environment Variables.

PORT=3000

# Google Gemini API Key untuk analisis konten & brand video otomatis
GEMINI_API_KEY=your_gemini_api_key_here

# Discord Webhook URL untuk notifikasi realtime aktivitas web app
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
